<?xml version="1.0" encoding="utf-8"?>
<!--
  LRCLIB 品牌标（歌词源 · 内置源行用）
  2026-10-21 ⑤：改为 Lucide 风格描边图标（24×24, strokeWidth 2.75, round cap/join, 无填色），
  与设置页其他 Lucide 图标视觉统一。strokeColor 仅占位，实际颜色由 OIcon(tint=...) 跟随行文字色。
  字形 "LRC"：L=竖+底横（左竖、脚向右）；R=竖+上半圆+斜腿；C=右侧开口半圆弧（凸向左）。
  修复要点：上一版 L 画成纯竖条被识成 I、字母过小；本版 L 带明确底横、字母整体放大。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 圆角方框（library 容器轮廓） -->
    <path
        android:strokeColor="#201E1D"
        android:strokeWidth="2.75"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M5,3 H19 A2,2 0 0 1 21,5 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 Z" />
    <!-- L：竖 + 底横（脚向右） -->
    <path
        android:strokeColor="#201E1D"
        android:strokeWidth="2.75"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M5,7 V17 H9" />
    <!-- R：竖 + 上半圆 bowl（凸向右）+ 斜腿 -->
    <path
        android:strokeColor="#201E1D"
        android:strokeWidth="2.75"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M10.5,7 V17 M10.5,7 H12 A2,2 0 0 1 12,11 H10.5 M11.5,11 L13.5,17" />
    <!-- C：右侧开口半圆弧（凸向左，开口朝右） -->
    <path
        android:strokeColor="#201E1D"
        android:strokeWidth="2.75"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M18,9 A3.2,3.2 0 0 0 18,15" />
</vector>
