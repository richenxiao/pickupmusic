.idea/
*.iml
.DS_Store

# ─── Build artifacts / APK / AAB / heap dumps ───
*.apk
*.aab
*.hprof
*.prof
*.profm

# ─── Misc temp / backup ───
*.zip
*.rar
*.log
*.bin
*.dat
*.lock

# ─── JS toolchain (sharp 等，仅用于资源预处理) ───
node_modules/

