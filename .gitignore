# ─── Build outputs ───
/build/
/app/build/
/*/build/
captures/
.externalNativeBuild/
.cxx/

# ─── Gradle / Kotlin caches ───
.gradle/
.kotlin/

# ─── Local SDK / machine config (NEVER commit) ───
local.properties

